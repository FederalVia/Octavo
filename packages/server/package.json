{
  "name": "@octavo/server",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "octavo": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts serve --vault ../../vault",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@octavo/core": "*",
    "acme-client": "^5.4.0",
    "express": "^5.1.0",
    "katex": "~0.18.10",
    "marked": "^18.1.3",
    "marked-footnote": "^1.4.0",
    "marked-katex-extension": "^5.1.13",
    "qrcode": "^1.5.4",
    "turndown": "^7.2.5",
    "undici": "^7.30.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "AGPL-3.0-or-later"
}
