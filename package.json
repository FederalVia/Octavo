{
  "name": "octavo",
  "version": "1.0.0",
  "private": true,
  "description": "A Markdown knowledge base you see as a brain, and that AI assistants use as long-term memory over MCP.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web",
    "packages/desktop"
  ],
  "scripts": {
    "build": "npm run build -w @octavo/core && npm run build -w @octavo/server && npm run build -w @octavo/web",
    "start": "node packages/server/dist/cli.js serve",
    "demo": "node packages/server/dist/cli.js serve --vault examples/demo-vault",
    "mcp": "node packages/server/dist/cli.js mcp",
    "dev:server": "npm run dev -w @octavo/server",
    "dev:web": "npm run dev -w @octavo/web",
    "desktop": "npm run build && npm start -w @octavo/desktop",
    "test": "npm test -w @octavo/core && npm test -w @octavo/server && npm test -w @octavo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dist:desktop": "npm run build && node scripts/build-desktop.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0"
  },
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "lodash-es": "^4.18.1",
    "minimatch@>=7 <11.0.1": "^11.0.5",
    "@excalidraw/mermaid-to-excalidraw": {
      "mermaid": {
        "katex": "~0.18.10"
      }
    },
    "nanoid": "^3.3.20"
  }
}
