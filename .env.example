# Copy this file to .env and fill it in. Docker Compose reads .env automatically.
# Never commit .env: it contains your secrets (it's already in .gitignore).

# Required. A long random secret that unlocks your notes. Generate one with:
#   docker run --rm node:22-slim node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OCTAVO_TOKEN=

# Folder on this computer where your notes are stored (plain Markdown files).
OCTAVO_VAULT_DIR=./vault

# --- Only for docker-compose.tailscale.yml -----------------------------------
# Auth key from https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
# Name of this machine on your tailnet -> https://octavo.<your-tailnet>.ts.net
TS_HOSTNAME=octavo

# --- Only for docker-compose.caddy.yml ---------------------------------------
# Your domain, pointing at your home IP (e.g. mind.example.com)
OCTAVO_DOMAIN=
